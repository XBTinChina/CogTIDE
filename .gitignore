# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local environment
.env
.env.*
!.env.example

# Generated pipeline outputs (per-run artifacts) and cross-run memory.
# These are produced at runtime and must not be committed — they may
# contain unpublished research material.
runs/
memory/

# Local research materials dropped into question/ subfolders. The scaffold
# (README + .gitkeep) is kept; everything else a user adds is ignored.
question/*
!question/README.md
!question/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
