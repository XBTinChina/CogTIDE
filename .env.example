# cogTIDE environment configuration — EXAMPLE.
#
# Copy this file to `.env` at the repository root and fill in your own key:
#
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real API keys. Shell-exported
# variables take precedence over values in `.env`.
#
# cogTIDE uses any OpenAI-compatible chat-completions endpoint. Set the key
# for the provider you configured in `configs/models.yaml`. By default the
# loader looks for LLM_API_KEY first, then OPENAI_API_KEY.

# Primary key (matches api_key_env in configs/models.yaml).
LLM_API_KEY=your-api-key-here

# Optional fallback (used only if LLM_API_KEY is unset).
# OPENAI_API_KEY=your-openai-key-here

# --- Provider examples ---------------------------------------------------
# The key variable name is arbitrary as long as it matches api_key_env in
# configs/models.yaml. Some users prefer a provider-specific name, e.g.:
#   OPENAI_API_KEY=...      # OpenAI            (api.openai.com/v1)
#   ZHIPU_API_KEY=...       # Zhipu GLM         (open.bigmodel.cn/api/paas/v4)
#   MOONSHOT_API_KEY=...    # Moonshot Kimi     (api.moonshot.cn/v1)
# If you use one of these, set api_key_env in configs/models.yaml to match.
