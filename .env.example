# cogTIDE environment configuration — EXAMPLE.
#
# Copy this file to `.env` at the repository root and fill in your own key:
#
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real API keys. Shell-exported
# variables take precedence over values in `.env`.
#
# cogTIDE uses any OpenAI-compatible chat-completions endpoint. Set the key
# for the provider you configured in `configs/models.yaml`. The shipped
# default targets Zhipu GLM, so it looks for ZHIPU_API_KEY first, then
# OPENAI_API_KEY.

# Primary key (matches api_key_env in configs/models.yaml — default: Zhipu GLM).
ZHIPU_API_KEY=your-zhipu-api-key-here

# Optional fallback (used only if the primary key variable is unset).
# OPENAI_API_KEY=your-openai-key-here

# --- Other providers -----------------------------------------------------
# The key variable name is arbitrary as long as it matches api_key_env in
# configs/models.yaml. If you switch providers there, set the matching key:
#   OPENAI_API_KEY=...      # OpenAI            (api.openai.com/v1)
#   MOONSHOT_API_KEY=...    # Moonshot Kimi     (api.moonshot.cn/v1)
#   LLM_API_KEY=...         # a generic name you choose
