{
  "$defs": {
    "DimensionAggregate": {
      "additionalProperties": false,
      "description": "Aggregated score for one quality dimension across all reviewers.",
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "mean_score": {
          "default": 0.0,
          "title": "Mean Score",
          "type": "number"
        },
        "std_score": {
          "default": 0.0,
          "title": "Std Score",
          "type": "number"
        },
        "mean_predicted": {
          "default": 0.0,
          "title": "Mean Predicted",
          "type": "number"
        },
        "actual_minus_predicted": {
          "default": 0.0,
          "title": "Actual Minus Predicted",
          "type": "number"
        },
        "n_reviews": {
          "default": 0,
          "title": "N Reviews",
          "type": "integer"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "DimensionAggregate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scorecard for one Stage 1 idea, computed from blind peer reviews.\n\nUsed by the Stage 2 coalition selector to rank and select ideas.",
  "properties": {
    "idea_id": {
      "title": "Idea Id",
      "type": "string"
    },
    "source_lens": {
      "default": "",
      "title": "Source Lens",
      "type": "string"
    },
    "quality_score": {
      "default": 0.0,
      "title": "Quality Score",
      "type": "number"
    },
    "unexpected_support": {
      "default": 0.0,
      "title": "Unexpected Support",
      "type": "number"
    },
    "survival_forecast": {
      "default": 0.0,
      "title": "Survival Forecast",
      "type": "number"
    },
    "calibration_weighted_score": {
      "default": 0.0,
      "title": "Calibration Weighted Score",
      "type": "number"
    },
    "is_underrated": {
      "default": false,
      "title": "Is Underrated",
      "type": "boolean"
    },
    "reviewer_disagreement": {
      "default": 0.0,
      "title": "Reviewer Disagreement",
      "type": "number"
    },
    "diversity_contribution": {
      "default": 0.0,
      "title": "Diversity Contribution",
      "type": "number"
    },
    "dimension_scores": {
      "items": {
        "$ref": "#/$defs/DimensionAggregate"
      },
      "title": "Dimension Scores",
      "type": "array"
    },
    "n_reviews": {
      "default": 0,
      "title": "N Reviews",
      "type": "integer"
    },
    "reviewer_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reviewer Ids",
      "type": "array"
    }
  },
  "required": [
    "idea_id"
  ],
  "title": "IdeaScorecard",
  "type": "object"
}